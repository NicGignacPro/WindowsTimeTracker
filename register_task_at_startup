# ============================================================
#  Create-SedentaryReminderTask.ps1
#  Crée une tâche planifiée qui lance WindowsTimeTracker.py
#  au démarrage de Windows (connexion de l'utilisateur).
#  À exécuter UNE SEULE FOIS en tant qu'Administrateur.
# ============================================================

$TaskName    = "SedentaryReminder"
$ScriptPath  = "C:\Users\MANI4218\Documents\Projets\WindowsTimeTracker\WindowsTimeTracker.py"
$PythonExe   = (Get-Command python -ErrorAction SilentlyContinue).Source

# ── Vérifications préliminaires ──────────────────────────────

if (-not $PythonExe) {
    Write-Error "Python introuvable dans le PATH. Installe Python ou ajoute-le au PATH système."
    exit 1
}

if (-not (Test-Path $ScriptPath)) {
    Write-Warning "Le fichier '$ScriptPath' n'existe pas encore. La tâche sera quand même créée."
}

# ── Supprimer l'ancienne tâche si elle existe déjà ───────────

if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) {
    Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false
    Write-Host "Ancienne tâche '$TaskName' supprimée." -ForegroundColor Yellow
}

# ── Définir les composants de la tâche ───────────────────────

# Action : lancer python avec le script en argument
$Action = New-ScheduledTaskAction `
    -Execute $PythonExe `
    -Argument "`"$ScriptPath`"" `
    -WorkingDirectory (Split-Path $ScriptPath)

# Déclencheur : à chaque ouverture de session de l'utilisateur courant
$Trigger = New-ScheduledTaskTrigger -AtLogOn -User $env:USERNAME

# Paramètres : fenêtre cachée, redémarrage auto si plantage
$Settings = New-ScheduledTaskSettingsSet `
    -ExecutionTimeLimit (New-TimeSpan -Hours 0) `
    -RestartCount 3 `
    -RestartInterval (New-TimeSpan -Minutes 1) `
    -StartWhenAvailable

# Principal : s'exécute avec la session interactive de l'utilisateur
$Principal = New-ScheduledTaskPrincipal `
    -UserId $env:USERNAME `
    -LogonType Interactive `
    -RunLevel Highest

# ── Enregistrer la tâche ─────────────────────────────────────

$Task = Register-ScheduledTask `
    -TaskName   $TaskName `
    -Action     $Action `
    -Trigger    $Trigger `
    -Settings   $Settings `
    -Principal  $Principal `
    -Description "Lance WindowsTimeTracker.py automatiquement à la connexion Windows."

if ($Task) {
    Write-Host ""
    Write-Host "✅ Tâche '$TaskName' créée avec succès !" -ForegroundColor Green
    Write-Host "   Python  : $PythonExe"                  -ForegroundColor Cyan
    Write-Host "   Script  : $ScriptPath"                 -ForegroundColor Cyan
    Write-Host "   Trigger : À chaque connexion de $env:USERNAME" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "Commandes utiles :"
    Write-Host "  Démarrer  : Start-ScheduledTask  -TaskName '$TaskName'"
    Write-Host "  Arrêter   : Stop-ScheduledTask   -TaskName '$TaskName'"
    Write-Host "  Supprimer : Unregister-ScheduledTask -TaskName '$TaskName' -Confirm:`$false"
} else {
    Write-Error "Échec de la création de la tâche."
    exit 1
}